{
  "name": "ezequiel-coaching-desktop",
  "version": "1.0.0",
  "description": "EZEQUIEL COACHING — Windows & Mac native (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_START_URL=http://localhost:3001 electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:all": "electron-builder --win --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ezequielcoaching.desktop",
    "productName": "EZEQUIEL COACHING",
    "files": ["main.js", "preload.js", "../public/**/*", "../.next/**/*"],
    "directories": { "buildResources": "../public/icons" },
    "win": { "target": "nsis", "icon": "../public/icons/icon-512.png" },
    "mac": { "target": "dmg", "icon": "../public/icons/icon-512.png", "category": "public.app-category.healthcare-fitness" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
