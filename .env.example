# ==========================================
# KINETIXFIT - VARIABLES DE ENTORNO
# ==========================================
# COPIAR ESTE ARCHIVO COMO .env Y COMPLETAR CON CREDENCIALES REALES
# NUNCA COMMITEAR EL ARCHIVO .env CON CREDENCIALES REALES A GIT

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Database URLs (Prisma)
DATABASE_URL="postgresql://usuario:password@host:5432/kinetixfit?schema=public"
DIRECT_URL="postgresql://usuario:password@host:5432/kinetixfit?schema=public"

# ------------------------------------------
# JWT & Authentication
# ------------------------------------------
JWT_SECRET="tu-secreto-super-seguro-de-al-menos-32-caracteres-aleatorios"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# ------------------------------------------
# Stripe Payment Gateway
# ------------------------------------------
STRIPE_SECRET_KEY="sk_live_tu-clave-secreta-de-stripe"
STRIPE_PUBLISHABLE_KEY="pk_live_tu-clave-publica-de-stripe"
STRIPE_WEBHOOK_SECRET="whsec_tu-secreto-de-webhook-de-stripe"
STRIPE_PRICE_ID_PREMIUM="price_tu-id-de-precio-premium"

# ------------------------------------------
# Mercado Pago Payment Gateway
# ------------------------------------------
MP_ACCESS_TOKEN="APP_USR-tu-access-token-de-mercado-pago"
MP_PUBLIC_KEY="APP_USR-tu-public-key-de-mercado-pago"
MP_WEBHOOK_SECRET="tu-secreto-de-webhook-de-mercado-pago"

# ------------------------------------------
# Email Transaccional — KINETIXFITT (Resend > SMTP)
# ------------------------------------------
# Resend preferido (si existe, se usa fetch a https://api.resend.com/emails)
RESEND_API_KEY=re_xxx
# Compat con apps/mobile/.env.example: EMAIL_FROM es el remitente canónico
EMAIL_FROM="KINETIXFITT <noreply@kinetixfit.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-password-de-aplicacion
SMTP_FROM="KINETIXFITT <noreply@kinetixfit.com>"
# Alias soportados por lib/email.ts: SMTP_PASS, SMTP_USER, EMAIL_FROM

# ------------------------------------------
# AWS S3 Configuration (Backups & Assets)
# ------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu-access-key-id-de-aws
AWS_SECRET_ACCESS_KEY=tu-secret-access-key-de-aws
BACKUP_S3_BUCKET=kinetixfit-backups-prod
ASSETS_S3_BUCKET=kinetixfit-assets-prod

# ------------------------------------------
# Sentry Error Tracking
# ------------------------------------------
SENTRY_DSN=https://tu-dsn-de-sentry@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production

# ------------------------------------------
# Application URLs
# ------------------------------------------
NEXT_PUBLIC_APP_URL=https://kinetixfit.com
API_URL=https://api.kinetixfit.com
WEB_URL=https://app.kinetixfit.com
MOBILE_DEEP_LINK=kinetixfit://

# ------------------------------------------
# Redis (Opcional para caching)
# ------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# Firebase (DEPRECATED - Solo migración)
# ------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------
# VAPID Keys for Push Notifications
# ------------------------------------------
VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key
