# ==========================================
# KINETIXFITT - VARIABLES DE ENTORNO
# ==========================================
# Copiar como .env.local/.env y completar con credenciales reales.
# Nunca commitear secretos reales.

# ------------------------------------------
# Supabase / Prisma PostgreSQL
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
DATABASE_URL="postgresql://usuario:password@host:5432/kinetixfit?schema=public"
DIRECT_URL="postgresql://usuario:password@host:5432/kinetixfit?schema=public"

# ------------------------------------------
# Authentication / trusted proxy
# ------------------------------------------
JWT_SECRET="genera-un-secreto-aleatorio-de-32-o-mas-caracteres"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"
# true solo cuando el proxy de borde sobrescribe los headers de IP.
TRUST_PROXY_HEADERS=true
KINETIX_INTERNAL_API_SECRET="genera-otro-secreto-aleatorio-de-32-o-mas-caracteres"
BACKUP_ADMIN_USER_IDS="cuid-admin-1,cuid-admin-2"

# ------------------------------------------
# AI provider (OpenAI-compatible)
# ------------------------------------------
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
OPENAI_API_KEY=""
GLM_API_KEY=""

# ------------------------------------------
# Stripe
# ------------------------------------------
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_PREMIUM="price_..."
STRIPE_CHECKOUT_CURRENCY="ARS"

# ------------------------------------------
# Mercado Pago
# ------------------------------------------
MP_ACCESS_TOKEN="APP_USR-..."
MP_PUBLIC_KEY="APP_USR-..."
MP_WEBHOOK_SECRET="..."
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# ------------------------------------------
# Email
# ------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="KINETIXFITT <noreply@kinetixfitt.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="KINETIXFITT <noreply@kinetixfitt.com>"

# ------------------------------------------
# Storage / Backups
# ------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BACKUP_S3_BUCKET="kinetixfitt-backups-prod"
ASSETS_S3_BUCKET="kinetixfitt-assets-prod"
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_DIR=""

# ------------------------------------------
# Rate limiting / Redis
# ------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""

# ------------------------------------------
# Push notifications
# ------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ------------------------------------------
# Observability
# ------------------------------------------
SENTRY_DSN=""
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------
# URLs
# ------------------------------------------
NEXT_PUBLIC_APP_URL=https://kinetixfitt.com
NEXT_PUBLIC_WEB_URL=https://kinetixfitt.com
API_URL=https://api.kinetixfitt.com
WEB_URL=https://app.kinetixfitt.com
CAPACITOR_SERVER_URL=https://app.kinetixfitt.com
MOBILE_DEEP_LINK=kinetixfitt://
