{
  "name": "kinetix",
  "version": "1.0.0",
  "description": "Kinetix - Unified Platform for fitness coaching (mobile app + web dashboard)",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/mobile",
    "packages/shared",
    "packages/ai-models",
    "packages/core",
    "packages/native-modules"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "npm run mobile:build && npm run web:build",
    "test": "npm run test:mobile && npm run test:web",
    "test:mobile": "npm run test --workspace=apps/mobile",
    "test:web": "npm --prefix apps/web run test --if-present",
    "lint": "npm run lint:mobile && npm run lint:web",
    "lint:mobile": "npm run lint --workspace=apps/mobile",
    "lint:web": "npm --prefix apps/web run lint",
    "typecheck": "npm run typecheck:mobile && npm run typecheck:web",
    "typecheck:mobile": "npm run typecheck --workspace=apps/mobile",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "format": "npm run format --workspaces --if-present",
    "mobile": "npm -w apps/mobile run dev",
    "web": "npm --prefix apps/web run dev",
    "mobile:build": "npm -w apps/mobile run build",
    "web:build": "npm --prefix apps/web run build",
    "clean": "npm run clean --workspaces && rm -rf node_modules .turbo",
    "clean:web": "npm --prefix apps/web run clean --if-present"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@tanstack/react-table": "^8.21.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "zustand": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  }
}
