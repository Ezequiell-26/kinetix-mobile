```gitignore
# Dependencies
node_modules/
vendor/

# Build outputs
dist/
build/
.next/
.nuxt/
public/dist/
out/

# Environment variables
.env
.env.local
.env.*
!.env.example

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
htmlcov/
.coverage.*
.pytest_cache/
.mypy_cache/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled and binary files
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.obj
*.a
*.lib
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Coverage reports
coverage/
coverage.xml
*.lcov
*.info

# Testing
test-reports/
junit.xml
```