        <div className="absolute top-24 left-1/2 -translate-x-1/2 w-[900px] h-[420px] rounded-full blur-[90px] opacity-[0.06]" style={{ background: TEAL }} />

        <div className="relative max-w-[1200px] mx-auto px-4 sm:px-6">
