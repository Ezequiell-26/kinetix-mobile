              <span className="hidden sm:inline-flex items-center gap-1.5"><Award size={12} style={{ color: TEAL }} /> Prensa:</span>
              <span className="font-black tracking-widest text-zinc-900">TN</span><span className="text-zinc-300">·</span><span className="font-black tracking-widest text-zinc-900">INFOBAE</span><span className="text-zinc-300">·</span><span className="font-black tracking-widest text-zinc-900">CLARÍN</span>
              <span className="ml-1 hidden md:inline text-zinc-400 font-semibold">“La app que profesionaliza el fitness LATAM”</span>
            </div>
