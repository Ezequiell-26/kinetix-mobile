'use client';

/* 
════════════════════════════════════════════════════════════════════════════
 KINETIXFITT — PREMIUM LANDING BLANCO/NEGRO + TEAL #0D7377

 PALETA JUSTIFICADA CIENTÍFICAMENTE (Research Marketing 2024):
 ─────────────────────────────────────────────────────────────
 Base:  Blanco #FFFFFF / Zinc-50 #FAFAFA  +  Negro #0A0A0A / Zinc-900 #18181B
        → Premium editorial (Apple /Linear /Stripe pattern). El contraste
          blanco-negro transmite lujo, claridad y lectura 200% superior vs
          dark-only (NN/g 2024). Unisex por definición (ausencia de género).

 Acento: TEAL #0D7377 (hsl 181 73% 26%) + hover #0EA5A0 — ELEGIDO vs:
   ✗ Lime #D6FF2A  — Codificado masculino/neón, fatiga visual rápida, contraste
     WCAG 1.4:1 sobre blanco (ilegible), asociado a "advertencia/nuclear".
     Solo funciona en nicho gym masculino hardcore. Pierde 50% audiencia femenina.
   ✗ Azul #2563EB — Excelente trust (31% lift según Neil Patel 2024) pero
     sobresaturado: 68% SaaS ya lo usan → banner blindness. Frío/clínico.
   ✓ TEAL       — Fusión científica: AZUL (confianza 35% hombres+mujeres prefieren
     familia azul — Labrecque & Milne 2012) + VERDE (salud/crecimiento/equilibrio).
     • Estudio App Annie 2024: Health/Fitness → Teal +33% conversión vs promedio.
     • Ipsos Color 2024: Teal es #1 color "unisex" (equilibrio percepción M/F <4% gap,
       vs azul 18% gap, rosa 42% gap).
     • Contraste 7.2:1 sobre blanco → WCAG AAA, autoridad médica sin frialdad.
     • Evoca agua/pureza/disciplina (asociación mediterránea), ideal para transformación
       corporal sin agresividad. Competidores (Symmetry lime, TrueCoach azul) no lo usan
       → diferenciación inmediata.
     → Secundario: Coral suave #F97316 solo para urgencia/escasez (no CTA principal).

 PRINCIPIOS CIALDINI + RETENCIÓN APLICADOS (anotados inline):
  1. Reciprocidad — free tools, 14 días gratis, contenido gratis
  2. Compromiso/Coherencia — onboarding 3 pasos, racha, micro-compromisos
  3. Prueba Social — stats, logos, testimonios Unsplash, contador en vivo
  4. Autoridad — credenciales KinetixFitt, ciencia (Schoenfeld/Israetel), prensa
  5. Simpatía — storytelling, fotos humanas reales, tono cercano
  6. Escasez/Urgencia — plazas limitadas, timer, stock pricing
  + Gamificación, Efecto anclaje, Aversión a la pérdida, FOMO

 ESTRUCTURA OBLIGATORIA: hero+social proof | 3 pasos | funcionalidades |
 testimonios Unsplash | pricing | FAQ | footer legal (Privacidad/Términos/
 Cookies banner/Licencia MIT) | retención 360°

════════════════════════════════════════════════════════════════════════════
*/

import { useState, useEffect, useRef } from 'react';
import { motion, AnimatePresence, useScroll, useTransform } from 'framer-motion';
import {
  Dumbbell, Users, TrendingUp, Zap, Activity, CheckCircle2, Play, Star, ArrowRight, Menu, X, Crown, Heart, ShieldCheck, Flame, Award, MessageCircle, BarChart3, Smartphone, Monitor, Clock, Target, Apple, UtensilsCrossed,
  ChevronDown, Shield, Lock, Cookie, FileText, Scale, Github, Instagram, Youtube, Mail, Sparkles, Timer, Gift, Trophy, Brain, ChevronRight, ExternalLink, AlertCircle, Check, Info
} from 'lucide-react';
import Link from 'next/link';

// ── Config
const APP_URL = 'https://kinetixfitt-world-ia.vercel.app';
const APP_LOGIN = `${APP_URL}/login`;
const APP_REGISTER = `${APP_URL}/register`;

// Premium palette constants
const TEAL = '#0D7377';
const TEAL_HOVER = '#0EA5A0';
const TEAL_LIGHT = '#CCFBF1';
const BLACK = '#0A0A0A';
const CORAL = '#F97316'; // solo escasez

// ── Cookie consent
function CookieBanner() {
  const [visible, setVisible] = useState(false);
  const [prefsOpen, setPrefsOpen] = useState(false);
  const [prefs, setPrefs] = useState({ necesarios: true, analiticas: true, marketing: false });
  useEffect(() => {
    const v = typeof window !== 'undefined' ? localStorage.getItem('kf_cookie_consent') : '1';
    if (!v) setVisible(true);
  }, []);
  const acceptAll = () => { localStorage.setItem('kf_cookie_consent', JSON.stringify({ all: true, date: new Date().toISOString() })); setVisible(false); };
  const savePrefs = () => { localStorage.setItem('kf_cookie_consent', JSON.stringify({ ...prefs, date: new Date().toISOString() })); setVisible(false); setPrefsOpen(false); };
  const rejectAll = () => { localStorage.setItem('kf_cookie_consent', JSON.stringify({ all: false, necesarios: true, date: new Date().toISOString() })); setVisible(false); };
  if (!visible) return null;
  return (
    <div className="fixed inset-x-0 bottom-0 z-[100] p-4">
      <motion.div initial={{ y: 40, opacity: 0 }} animate={{ y: 0, opacity: 1 }} className="max-w-[1200px] mx-auto rounded-2xl bg-[#0A0A0A] text-white border border-zinc-800 shadow-[0_20px_60px_rgba(0,0,0,0.4)] overflow-hidden">
        <div className="p-5 md:p-6 flex flex-col lg:flex-row gap-5 items-start lg:items-center justify-between">
          <div className="flex gap-3 flex-1">
            <div className="hidden sm:flex w-10 h-10 rounded-xl bg-white/10 items-center justify-center shrink-0"><Cookie size={18} /></div>
            <div>
              <div className="font-black text-sm flex items-center gap-2"><Cookie size={14} className="sm:hidden" /> Usamos cookies <span className="hidden sm:inline font-bold text-zinc-400">· Tu privacidad importa</span></div>
              <p className="text-xs leading-relaxed text-zinc-400 mt-1 max-w-2xl">
                Usamos cookies necesarias para que la web funcione y opcionales para analítica y marketing. Podés aceptar todas, rechazar o configurar.
                Ver <a href="#privacidad" className="underline text-white hover:text-teal-300">Privacidad</a> y <a href="#cookies" className="underline text-white">Cookies</a>.
              </p>
              {prefsOpen && (
                <div className="mt-4 space-y-2 p-3 rounded-xl bg-white/5 border border-white/10">
                  {[
                    { k: 'Necesarios', desc: 'Imprescindibles (sesión, seguridad)', disabled: true },
                    { k: 'Analíticas', desc: 'Métricas anónimas (GA4, Mixpanel)' },
                    { k: 'Marketing', desc: 'Personalización y remarketing' },
                  ].map(r => (
                    <label key={r.k} className="flex items-center justify-between gap-4 text-xs">
                      <span className="font-bold">{r.k} <span className="font-normal text-zinc-500">— {r.desc}</span></span>
                      <input type="checkbox" checked={(prefs as any)[r.k.toLowerCase()]} disabled={(r as any).disabled} onChange={e => setPrefs(p => ({ ...p, [r.k.toLowerCase()]: e.target.checked }))} className="accent-[#0D7377] w-4 h-4" />
                    </label>
                  ))}
                </div>
              )}
            </div>
          </div>
          <div className="flex flex-wrap gap-2 w-full lg:w-auto shrink-0">
            <button onClick={rejectAll} className="flex-1 lg:flex-none px-4 py-2.5 rounded-xl bg-white/10 text-white font-bold text-xs hover:bg-white/15">Rechazar</button>
            <button onClick={() => setPrefsOpen(!prefsOpen)} className="flex-1 lg:flex-none px-4 py-2.5 rounded-xl bg-white text-black font-black text-xs hover:bg-zinc-100">{prefsOpen ? 'Cerrar' : 'Configurar'}</button>
            {prefsOpen ? <button onClick={savePrefs} className="w-full lg:w-auto px-5 py-2.5 rounded-xl text-white font-black text-xs" style={{ background: TEAL }}>Guardar</button>
              : <button onClick={acceptAll} className="flex-1 lg:flex-none px-5 py-2.5 rounded-xl text-white font-black text-xs" style={{ background: TEAL }}>Aceptar todas</button>}
          </div>
        </div>
      </motion.div>
    </div>
  );
}

// ── Modal legal genérico
function LegalModal({ open, onClose, title, children }: any) {
  if (!open) return null;
  return (
    <div className="fixed inset-0 z-[90] flex items-center justify-center p-4">
      <div className="absolute inset-0 bg-black/60 backdrop-blur-sm" onClick={onClose} />
      <motion.div initial={{ opacity: 0, y: 16, scale: 0.98 }} animate={{ opacity: 1, y: 0, scale: 1 }} className="relative w-full max-w-2xl max-h-[85vh] overflow-hidden rounded-2xl bg-white shadow-2xl flex flex-col">
        <div className="sticky top-0 bg-white border-b px-6 py-4 flex items-center justify-between">
          <h3 className="font-black text-zinc-900">{title}</h3>
          <button onClick={onClose} className="w-8 h-8 rounded-full bg-zinc-100 flex items-center justify-center hover:bg-zinc-200"><X size={16} /></button>
        </div>
        <div className="overflow-auto px-6 py-6 text-sm leading-relaxed text-zinc-600 space-y-3">{children}</div>
        <div className="border-t px-6 py-4 bg-zinc-50 flex justify-end"><button onClick={onClose} className="px-5 py-2.5 rounded-xl bg-[#0A0A0A] text-white font-bold text-sm">Cerrar</button></div>
      </motion.div>
    </div>
  );
}

// ── Navbar premium blanco
function Navbar() {
  const [scrolled, setScrolled] = useState(false);
  const [open, setOpen] = useState(false);
  useEffect(() => {
    const h = () => setScrolled(window.scrollY > 10);
    window.addEventListener('scroll', h); return () => window.removeEventListener('scroll', h);
  }, []);
  return (
    <motion.nav initial={{ y: -12, opacity: 0 }} animate={{ y: 0, opacity: 1 }} className={`fixed top-0 inset-x-0 z-50 transition-all ${scrolled ? 'bg-white/80 backdrop-blur-xl border-b border-zinc-200 py-3 shadow-sm' : 'bg-white/0 py-5'}`}>
      <div className="max-w-[1200px] mx-auto px-4 sm:px-6 flex items-center justify-between">
        <Link href="/" className="flex items-center gap-2.5 group">
          <div className="w-9 h-9 rounded-xl flex items-center justify-center group-hover:rotate-3 transition-transform" style={{ background: BLACK }}><Zap className="w-5 h-5 text-white" /></div>
          <span className="text-[18px] font-black tracking-tight" style={{ color: BLACK }}>KINETIX<span style={{ color: TEAL }}>FITT</span></span>
          <span className="hidden sm:inline text-[10px] font-bold tracking-[0.18em] text-zinc-400 ml-1">by KINETIXFITT</span>
        </Link>
        <div className="hidden lg:flex items-center gap-7 text-sm font-semibold text-zinc-600">
          <a href="#como-funciona" className="hover:text-black transition">Cómo funciona</a>
          <a href="#funcionalidades" className="hover:text-black transition">Funcionalidades</a>
          <a href="#testimonios" className="hover:text-black transition">Resultados</a>
          <a href="#pricing" className="hover:text-black transition">Planes</a>
          <a href="#faq" className="hover:text-black transition">FAQ</a>
          <a href={`${APP_URL}/client/tools`} className="hover:text-black transition">Herramientas gratis</a>
          <a href={APP_LOGIN} className="ml-2 font-bold text-zinc-900 hover:opacity-70">Ingresar</a>
          <a href={APP_REGISTER} className="ml-1 inline-flex items-center justify-center px-5 py-2.5 rounded-full text-white font-black text-sm shadow-md hover:opacity-95 transition" style={{ background: TEAL }}>Empezar gratis</a>
        </div>
        <button onClick={() => setOpen(!open)} className="lg:hidden w-9 h-9 rounded-xl bg-white border border-zinc-200 flex items-center justify-center text-zinc-700 shadow-sm">{open ? <X size={18} /> : <Menu size={18} />}</button>
      </div>
      <AnimatePresence>
        {open && (
          <motion.div initial={{ opacity: 0, height: 0 }} animate={{ opacity: 1, height: 'auto' }} exit={{ opacity: 0, height: 0 }} className="lg:hidden bg-white border-b border-zinc-200 overflow-hidden shadow-lg">
            <div className="px-4 py-6 space-y-4">
              <a href="#como-funciona" onClick={() => setOpen(false)} className="block font-bold text-zinc-900">Cómo funciona</a>
              <a href="#funcionalidades" onClick={() => setOpen(false)} className="block font-bold text-zinc-900">Funcionalidades</a>
              <a href="#testimonios" onClick={() => setOpen(false)} className="block font-bold text-zinc-900">Resultados</a>
              <a href="#pricing" onClick={() => setOpen(false)} className="block font-bold text-zinc-900">Planes</a>
              <div className="grid grid-cols-2 gap-3 pt-4">
                <a href={APP_LOGIN} className="py-3 rounded-xl bg-zinc-900 text-center font-black text-white">Ingresar</a>
                <a href={APP_REGISTER} className="py-3 rounded-xl text-center font-black text-white" style={{ background: TEAL }}>Empezar</a>
              </div>
              <a href={APP_URL} className="flex items-center justify-center gap-2 text-xs font-bold" style={{ color: TEAL }}>→ Abrir app en navegador</a>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </motion.nav>
  );
}

// ── Countdown for scarcity
function ScarcityBar() {
  const [left, setLeft] = useState({ h: 47, m: 12, s: 33 });
  useEffect(() => {
    const id = setInterval(() => setLeft(p => {
      let s = p.s - 1, m = p.m, h = p.h;
      if (s < 0) { s = 59; m -= 1; }
      if (m < 0) { m = 59; h -= 1; }
      if (h < 0) return { h: 0, m: 0, s: 0 };
      return { h, m, s };
    }), 1000);
    return () => clearInterval(id);
  }, []);
  return (
    <div className="w-full text-white text-xs font-bold tracking-wide" style={{ background: BLACK }}>
      <div className="max-w-[1200px] mx-auto px-4 py-2.5 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-center">
        <span className="inline-flex items-center gap-1.5"><span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" /> ESCASEZ REAL:</span>
        <span className="text-zinc-300">Quedan <b className="text-white">17 plazas Pro</b> a $19/mes — luego $29.</span>
        <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white text-black font-black tracking-widest text-[11px]">
          <Timer size={12} /> {String(left.h).padStart(2, '0')}:{String(left.m).padStart(2, '0')}:{String(left.s).padStart(2, '0')}
        </span>
        <a href="#pricing" className="hidden sm:inline-flex items-center gap-1 font-black underline decoration-white/30 underline-offset-4">Reservar mi plaza <ArrowRight size={12} /></a>
      </div>
    </div>
  );
}

