{
  "name": "kinetixfitt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-platforms.ps1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test:stats": "tsx tests/stats.test.ts",
    "test:voice": "tsx tests/voice-engine.test.ts",
    "test:core": "node -e \"require('fs').copyFileSync('prisma/dev.db','prisma/test-core.db')\" && tsx tests/program-edit.test.ts",
    "test": "npm run test:stats && npm run test:core",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.8.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sentry/nextjs": "^10.74.0",
    "@types/three": "^0.186.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.15.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "next": "15.3.5",
    "prisma": "^6.8.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.56.4",
    "recharts": "^2.13.0",
    "tailwind-merge": "^3.3.0",
    "three": "^0.186.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
