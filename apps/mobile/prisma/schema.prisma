generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  TRAINER
  CLIENT
}
enum ClientStatus {
  ACTIVO
  PAUSADO
  PENDIENTE
  FINALIZADO
}
enum Goal {
  PERDIDA_GRASA
  HIPERTROFIA
  FUERZA
  RECOMPOSICION
  OTRO
}
enum SubscriptionPlan {
  BASICO
  PERSONALIZADO
  PREMIUM
}
enum SubscriptionStatus {
  ACTIVA
  VENCIDA
  CANCELADA
  PENDIENTE
}
enum PaymentStatus {
  PAGADO
  PENDIENTE
  VENCIDO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile?
  client    Client?
  trainerProfile TrainerProfile?
  trainerClients Client[] @relation("TrainerClients")
  messagesSent Message[] @relation("Sent")
  messagesReceived Message[] @relation("Received")
  notifications Notification[]
  notificationPreference NotificationPreference?
  checkIns CheckIn[]
  workoutLogs WorkoutLog[]
  sessions Session[]
  pushSubscriptions PushSubscription[]
  progressMeasurements ProgressMeasurement[]
  progressPhotos ProgressPhoto[]

  @@index([email])
  @@index([role])
}

model Profile {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  age         Int?
  goal        Goal?
  experience  String?
  availability Int?
  equipment   String?
  notes       String?
  weight      Float?
  height      Float?
  bio         String?
}

model TrainerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio    String?
  specialty String?
}

model Client {
  id            String       @id @default(cuid())
  userId        String?      @unique
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Ownership multi-trainer (P0): un trainer solo opera sus clientes.
  // Los clientes existentes (trainerId null) los adopta el seed/QA.
  trainerId     String?
  trainer       User?        @relation("TrainerClients", fields: [trainerId], references: [id], onDelete: SetNull)
  name          String
  email         String       @unique
  avatar        String?
  goal          Goal         @default(HIPERTROFIA)
  status        ClientStatus @default(ACTIVO)
  plan          SubscriptionPlan @default(PERSONALIZADO)
  startDate     DateTime     @default(now())
  nextReview    DateTime?
  notes         String?
  trainerNotes  String?
  age           Int?
  weight        Float?
  height        Float?
  experience    String?
  availability  Int?
  equipment     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignedProgramId String?
  assignedProgram Program? @relation(fields: [assignedProgramId], references: [id], onDelete: SetNull)
  workoutLogs   WorkoutLog[]
  checkIns      CheckIn[]
  messages      Message[]
  progressMeasurements ProgressMeasurement[]
  progressPhotos ProgressPhoto[]
  subscription  Subscription?
  payments    Payment[]

  @@index([email])
  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@index([trainerId])
}

model Exercise {
  id            String @id @default(cuid())
  name          String
  muscleGroup   String
  pattern       String?
  equipment     String?
  level         String @default("Intermedio")
  image         String?
  video         String?
  instructions  String?
  errors        String?
  variants      String?
  substitutions String?
  createdAt     DateTime @default(now())
  workoutExercises WorkoutExercise[]
}

model Program {
  id          String @id @default(cuid())
  name        String
  description String?
  durationWeeks Int @default(4)
  frequency   Int @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phases      Phase[]
  weeks       ProgramWeek[]
  clients     Client[]
}

model Phase {
  id        String @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  order     Int @default(0)
  weeks     ProgramWeek[]
  createdAt DateTime @default(now())

  @@index([programId])
}

model ProgramWeek {
  id        String @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  phaseId   String?
  phase     Phase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  weekNumber Int
  workouts  Workout[]
  @@unique([programId, weekNumber])
}

model Workout {
  id            String @id @default(cuid())
  weekId        String
  week          ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNumber     Int
  name          String
  description   String?
  estimatedMin  Int @default(60)
  exercises     WorkoutExercise[]
  logs          WorkoutLog[]
}

model WorkoutExercise {
  id          String @id @default(cuid())
  workoutId   String
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  order       Int @default(0)
  sets        Int @default(3)
  reps        String @default("8-12")
  rir         Int?
  rpe         Int?
  restSec     Int @default(90)
  tempo       String?
  load        String?
  notes       String?
  supersetGroup String?
  isCircuit   Boolean @default(false)

  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutLog {
  id         String @id @default(cuid())
  userId     String?
  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Opcional con SetNull: editar la estructura de un programa no borra el
  // historial del atleta; workoutName preserva el nombre original de la sesión.
  workoutId  String?
  workout    Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  workoutName String?
  date       DateTime @default(now())
  durationMin Int?
  comment    String?
  completed  Boolean @default(true)
  sets       ExerciseSetLog[]

  @@index([userId])
  @@index([clientId])
  @@index([date])
}

model ExerciseSetLog {
  id           String @id @default(cuid())
  logId        String
  log          WorkoutLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  exerciseName String
  setNumber    Int
  weight       Float?
  reps         Int?
  rir          Int?
  rpe          Int?
  completed    Boolean @default(true)
}

model ProgressMeasurement {
  id        String @id @default(cuid())
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  date      DateTime @default(now())
  weight    Float?
  chest     Float?
  waist     Float?
  arm       Float?
  leg       Float?
  bodyFat   Float?

  @@index([userId])
  @@index([clientId])
  @@index([date])
}

model ProgressPhoto {
  id        String @id @default(cuid())
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  url       String
  date      DateTime @default(now())
  note      String?
  isPrivate Boolean @default(true)

  @@index([userId])
  @@index([clientId])
  @@index([date])
}

model CheckIn {
  id        String @id @default(cuid())
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  date      DateTime @default(now())
  energia   Int?
  sueno     Int?
  estres    Int?
  entrenos  Int?
  rendimiento Int?
  molestias String?
  alimentacion String?
  progreso  Int?
  comentario String?
  fotos     String?
  trainerReply String?
  reviewed  Boolean @default(false)

  @@index([reviewed])
  @@index([date])
  @@index([clientId])
  @@index([userId])
}

model Message {
  id         String @id @default(cuid())
  senderId   String
  sender     User @relation("Sent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User @relation("Received", fields: [receiverId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  content    String
  image      String?
  read       Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([read])
  @@index([receiverId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String @default("info")
  read      Boolean @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model Subscription {
  id        String @id @default(cuid())
  clientId  String @unique
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @default(PERSONALIZADO)
  status    SubscriptionStatus @default(ACTIVA)
  nextPayment DateTime?
  price     Float?
  createdAt DateTime @default(now())
}

model Payment {
  id        String @id @default(cuid())
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  email     String?
  amount    Float
  currency  String @default("ARS")
  status    PaymentStatus @default(PENDIENTE)
  method    String?
  date      DateTime @default(now())
  description String?
  @@index([clientId])
}

// Recuperación de contraseña persistente (reemplaza el Map en memoria, que
// se perdía en cada reinicio del server y no funcionaba con más de una
// instancia). Se guarda un HASH del token (sha256), nunca el token en
// texto plano, por si la base de datos se filtra alguna vez.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
  lastUsed  DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([revoked])
}

// Preferencias de notificaciones del usuario
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Canales habilitados
  emailEnabled     Boolean @default(true)
  pushEnabled      Boolean @default(true)
  smsEnabled       Boolean @default(false)
  whatsappEnabled  Boolean @default(false)
  
  // Tipos de notificaciones
  workoutReminders    Boolean @default(true)
  nutritionTips       Boolean @default(true)
  progressUpdates     Boolean @default(true)
  messageNotifications Boolean @default(true)
  paymentReminders    Boolean @default(true)
  
  // Configuración de schedule
  timezone       String  @default("America/Argentina/Buenos_Aires")
  quietStart     String  @default("22:00") // Hora de inicio de modo no molestar
  quietEnd       String  @default("08:00") // Hora de fin de modo no molestar
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String?
  auth      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([active])
}
