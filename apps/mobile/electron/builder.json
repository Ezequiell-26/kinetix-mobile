{
  "appId": "com.kinetixfitt.app",
  "productName": "KINETIXFITT",
  "files": [
    "electron/**/*",
    "public/icons/**/*"
  ],
  "directories": {
    "output": "dist-electron"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "public/icons/icon-512.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "KINETIXFITT"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "public/icons/icon-512.png",
    "identity": null
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "public/icons/icon-512.png"
  },
  "electronVersion": "44.3.0"
}