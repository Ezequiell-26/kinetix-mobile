# ==========================================
# KINETIXFITT - VARIABLES DE ENTORNO (PRODUCCIÓN)
# ==========================================
# ESTE ARCHIVO NO DEBE COMMITEARSE A GIT
# Configurar en Vercel Dashboard > Project Settings > Environment Variables
# ==========================================

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Database URLs (Supabase pooler puerto 6543)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ------------------------------------------
# JWT & Authentication
# ------------------------------------------
# Generar con: openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres-aleatorios"

# ------------------------------------------
# Stripe (MODO LIVE)
# ------------------------------------------
STRIPE_SECRET_KEY="sk_live_tu-clave-secreta-de-stripe"
STRIPE_PUBLISHABLE_KEY="pk_live_tu-clave-publica-de-stripe"
STRIPE_WEBHOOK_SECRET="whsec_tu-secreto-de-webhook-de-stripe"

# ------------------------------------------
# Mercado Pago (MODO LIVE)
# ------------------------------------------
MP_ACCESS_TOKEN="APP_USR-tu-access-token-de-mercado-pago"
MP_PUBLIC_KEY="APP_USR-tu-public-key-de-mercado-pago"
MP_WEBHOOK_SECRET="tu-secreto-de-webhook-de-mercado-pago"

# ------------------------------------------
# Email Transaccional
# ------------------------------------------
RESEND_API_KEY=re_xxx_obtener_de_resend_com
EMAIL_FROM="KINETIXFITT <noreply@tudominio.com>"

# SMTP Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_app_password

# ------------------------------------------
# AWS S3 (Backups y Fotos de Progreso)
# ------------------------------------------
AWS_ACCESS_KEY_ID=tu-access-key-id
AWS_SECRET_ACCESS_KEY=tu-secret-access-key
AWS_REGION=us-east-1
BACKUP_S3_BUCKET=tu-bucket-backups

# ------------------------------------------
# Redis (Rate Limiting Distribuido - Opcional)
# ------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# Sentry (Monitoreo de Errores - Opcional)
# ------------------------------------------
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ------------------------------------------
# Dominio y App URL
# ------------------------------------------
NEXT_PUBLIC_APP_URL=https://tudominio.com

# ------------------------------------------
# Push Notifications (VAPID Keys)
# ------------------------------------------
# Generar con: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key

# ------------------------------------------
# Log Level
# ------------------------------------------
LOG_LEVEL=info

# ------------------------------------------
# Node Environment
# ------------------------------------------
NODE_ENV=production
