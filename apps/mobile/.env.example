# ── Desarrollo local: Supabase (pooler). Pedir valores al dueño, NUNCA commitear el .env ──
# Pooling (6543): la app Y las migraciones usan el pooler. El host directo
# db.*:5432 es IPv6 y no llega desde Vercel ni desde algunas redes: no usarlo.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
JWT_SECRET="change-me-32chars-minimum"
# ── Flujo de schema (NO usar `prisma migrate dev`: el pooler no soporta shadow DB) ──
# 1. Editar schema.prisma
# 2. ./node_modules/.bin/prisma migrate diff --from-migrations apps/mobile/prisma/migrations --to-schema-datamodel apps/mobile/prisma/schema.prisma --script > apps/mobile/prisma/migrations/YYYYMMDDHHMMSS_<nombre>/migration.sql
# 3. Aplicar con scripts/pg-apply (driver pg directo, `db execute` no commitea por pooler)
# 4. INSERT en _prisma_migrations + commit
# Producción - Variables requeridas
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Seguridad
TRUST_PROXY_HEADERS=true
CSP_REPORT_URI=/api/csp-report

# Stripe (pagos)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Mercado Pago (pagos)
MP_ACCESS_TOKEN=APP_USR-xxx
MP_WEBHOOK_SECRET=xxx
NEXT_PUBLIC_MP_PUBLIC_KEY=xxx

# Email transaccional (recuperación de contraseña, notificaciones) — KINETIXFITT
# Prioridad: RESEND_API_KEY (Resend API) > SMTP (nodemailer fallback)
RESEND_API_KEY=re_xxx
EMAIL_FROM="KINETIXFITT <noreply@tu-dominio.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_app_password
# Alternativos (compat): SMTP_PASSWORD, SMTP_FROM, SMTP_SECURE=false

# Backups automáticos
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_S3_BUCKET=tu-bucket-backups
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-1

# Redis (opcional para rate limiting distribuido)
REDIS_URL=redis://localhost:6379

# Sentry (monitoreo de errores)
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# Log level
LOG_LEVEL=info

# ── Firebase Authentication (requerido para login) ──
NEXT_PUBLIC_FIREBASE_API_KEY=TU_API_KEY_AQUI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Instrucciones Firebase:
# 1. https://console.firebase.google.com/
# 2. Crear proyecto "KinetixFitt"
# 3. Authentication > Sign-in method > Habilitar Google y Email/Password
# 4. Project Settings > General > Your apps > Web app > Copiar credenciales arriba
# 5. Authentication > Settings > Authorized domains > Agregar: localhost, tu-dominio.vercel.app

