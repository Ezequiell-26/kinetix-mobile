# ── Desarrollo local: Supabase (pooler). Pedir valores al dueño, NUNCA commitear el .env ──
# Pooling (6543): la app Y las migraciones usan el pooler. El host directo
# db.*:5432 es IPv6 y no llega desde Vercel ni desde algunas redes: no usarlo.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
JWT_SECRET="change-me-32chars-minimum"
# ── Flujo de schema (NO usar `prisma migrate dev`: el pooler no soporta shadow DB) ──
# 1. Editar schema.prisma
# 2. ./node_modules/.bin/prisma migrate diff --from-migrations apps/mobile/prisma/migrations --to-schema-datamodel apps/mobile/prisma/schema.prisma --script > apps/mobile/prisma/migrations/YYYYMMDDHHMMSS_<nombre>/migration.sql
# 3. Aplicar con scripts/pg-apply (driver pg directo, `db execute` no commitea por pooler)
# 4. INSERT en _prisma_migrations + commit
