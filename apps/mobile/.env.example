# Base de datos local (SQLite).
DATABASE_URL="file:./dev.db"

# Secreto de firma de los JWT. MÍNIMO 32 caracteres.
# Obligatorio en producción: el servidor no arranca sin él.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-32chars-minimum"

# URL pública de la app. Se usa para validar el header Origin de los
# Server Actions (protección CSRF). Sin esta variable, Next usa el host
# de la propia request, que es el comportamiento correcto en same-origin.
# NEXT_PUBLIC_APP_URL="https://tu-dominio.com"

# Headers de proxy (X-Forwarded-For / X-Real-IP / CF-Connecting-IP).
# Poner en "true" SOLO si hay un proxy delante que SOBREESCRIBE esos
# headers con la IP real (Vercel, Cloudflare, o un Nginx propio
# configurado para descartar los del cliente). Si se activa sin ese
# proxy, el rate limiting se puede evadir rotando el header.
# TRUST_PROXY_HEADERS="false"

# --- Accesos de demostración en la pantalla de login (solo desarrollo) ---
# Si están definidos, la pantalla muestra los botones "Trainer demo" y
# "Cliente demo". Dejar VACÍOS en producción: son credenciales reales.
# NEXT_PUBLIC_DEMO_TRAINER_EMAIL=""
# NEXT_PUBLIC_DEMO_TRAINER_PASSWORD=""
# NEXT_PUBLIC_DEMO_CLIENT_EMAIL=""
# NEXT_PUBLIC_DEMO_CLIENT_PASSWORD=""
