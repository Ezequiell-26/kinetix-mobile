# ==========================================
# KINETIXFITT - VARIABLES DE ENTORNO (PRODUCCIÓN)
# ==========================================
# ESTE ARCHIVO DEBE SER CONFIGURADO CON CREDENCIALES REALES
# NUNCA COMMITEAR ESTE ARCHIVO A GIT CON DATOS SENSIBLES
# 
# INSTRUCCIONES:
# 1. Copiar este archivo como .env
# 2. Reemplazar TODOS los valores placeholder con credenciales reales
# 3. Generar JWT_SECRET con: openssl rand -base64 32
# 4. Configurar webhooks en Stripe/Mercado Pago una vez el dominio esté activo
# ==========================================

# ------------------------------------------
# Supabase Configuration (OBTENER DE SUPABASE DASHBOARD)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Database URLs (Prisma) - Usar connection pooling para producción
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ------------------------------------------
# JWT & Authentication (GENERAR SECRET SEGURO)
# ------------------------------------------
# GENERAR CON: openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres-aleatorios"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# ------------------------------------------
# Stripe Payment Gateway (MODO LIVE)
# ------------------------------------------
# Obtener de: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_tu-clave-secreta-de-stripe"
STRIPE_PUBLISHABLE_KEY="pk_live_tu-clave-publica-de-stripe"
STRIPE_WEBHOOK_SECRET="whsec_tu-secreto-de-webhook-de-stripe"
STRIPE_PRICE_ID_PREMIUM="price_tu-id-de-precio-premium"

# ------------------------------------------
# Mercado Pago Payment Gateway (MODO LIVE)
# ------------------------------------------
# Obtener de: https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN="APP_USR-tu-access-token-de-mercado-pago"
MP_PUBLIC_KEY="APP_USR-tu-public-key-de-mercado-pago"
MP_WEBHOOK_SECRET="tu-secreto-de-webhook-de-mercado-pago"

# ------------------------------------------
# Email Transaccional — KINETIXFITT
# ------------------------------------------
# Opción A: Resend (Recomendado)
RESEND_API_KEY=re_xxx_obtener_de_resend_com
EMAIL_FROM="KINETIXFITT <noreply@kinetixfit.com>"

# Opción B: SMTP (Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password-de-gmail
SMTP_FROM="KINETIXFITT <noreply@kinetixfit.com>"

# ------------------------------------------
# AWS S3 Configuration (Backups & Assets)
# ------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu-access-key-id-de-aws
AWS_SECRET_ACCESS_KEY=tu-secret-access-key-de-aws
BACKUP_S3_BUCKET=kinetixfit-backups-prod
ASSETS_S3_BUCKET=kinetixfit-assets-prod

# ------------------------------------------
# Sentry Error Tracking
# ------------------------------------------
# Obtener DSN de: https://sentry.io/settings/[org]/projects/[project]/keys/
SENTRY_DSN=https://tu-dsn-de-sentry@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production

# ------------------------------------------
# Application URLs (CONFIGURAR CON DOMINIO REAL)
# ------------------------------------------
NEXT_PUBLIC_APP_URL=https://kinetixfit.com
API_URL=https://api.kinetixfit.com
WEB_URL=https://app.kinetixfit.com
MOBILE_DEEP_LINK=kinetixfit://

# ------------------------------------------
# Redis (Opcional para caching distribuido)
# ------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# VAPID Keys for Push Notifications
# ------------------------------------------
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key

# ------------------------------------------
# PostHog Analytics (Retención de usuarios)
# ------------------------------------------
# Obtener de: https://us.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder_posthog_key_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------
# Seguridad y Rate Limiting
# ------------------------------------------
TRUST_PROXY_HEADERS=true
CSP_REPORT_URI=/api/csp-report
NODE_ENV=production
LOG_LEVEL=info

# ------------------------------------------
# Backup Automático
# ------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
